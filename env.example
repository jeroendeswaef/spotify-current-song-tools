# Copy to .env  —  cp env.example .env

# From https://developer.spotify.com/dashboard
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Must match a redirect URI registered on the app, byte-for-byte.
# Non-loopback URIs must be https (TLS is terminated by the tunnel).
SPOTIFY_REDIRECT_URI=

# Where the callback server actually listens — the local end of the tunnel.
# Use 0.0.0.0 if the mapping is a LAN port-forward rather than a tunnel client
# running on this machine.
AUTH_PORT=8084
AUTH_HOST=127.0.0.1

# The display. Both have working defaults in src/webhook.ts; set these to
# override, and prefer putting the token here over leaving it in source.
WEBHOOK_URL=
LEDCTRL_TOKEN=

# Whether to push song changes to the LED matrix. On by default; set to
# false/0/no/off to log changes without touching the display. The
# --updateLedMatrix / --no-updateLedMatrix flag overrides this.
UPDATE_LED_MATRIX=

# Where persisted BPMs live. Defaults to bpm.db in the project directory.
BPM_DB=

# Tempo-band playlists that `p` files songs into — the 22-character id from the
# playlist's share link (open.spotify.com/playlist/<id>). A band left empty
# still owns its BPM range; `p` just says it isn't configured.
PLAYLIST_SLOW_LINDY=
PLAYLIST_EASY_LINDY=
PLAYLIST_CLASSIC_LINDY=
PLAYLIST_CHARLESTON=
PLAYLIST_SHAG=
PLAYLIST_BALBOA=

# Optional tuning
POLL_INTERVAL_MS=5000
IDLE_INTERVAL_MS=15000

# Written to .tokens.json by `npm run authorize`. Only set this here if you'd
# rather inject it from a secret store (it takes precedence over the file).
# SPOTIFY_REFRESH_TOKEN=
